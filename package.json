{
  "name": "lobe",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "benchmark:vector": "bun run --filter '@lobe/db' benchmark:vector",
    "build": "bun run --filter '@lobe/*' build",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "db:generate": "bun run --filter '@lobe/db' db:generate",
    "db:migrate": "bun run --filter '@lobe/db' db:migrate",
    "db:seed": "bun run --filter '@lobe/db' db:seed",
    "db:studio": "bun run --filter '@lobe/db' db:studio",
    "dev:extension": "bun run --filter '@lobe/extension' dev",
    "dev:server": "bun run --filter '@lobe/server' dev",
    "dev:web": "bun run --filter '@lobe/web' dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --filter '@lobe/*' test",
    "typecheck": "bun run --filter '@lobe/*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
