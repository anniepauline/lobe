# Shared backend configuration
# Neon connection string. Enable the vector and pg_trgm extensions.
DATABASE_URL=
API_PORT=8787
APP_ORIGIN=http://localhost:5173
LOBE_API_TOKEN=change-me

# OpenAI stays on the server. Never put this key in an extension variable.
OPENAI_API_KEY=
OPENAI_REASONING_EFFORT=low

# Build-time extension default. Users can change this in the extension settings.
WXT_PUBLIC_API_URL=http://localhost:8787
WXT_PUBLIC_APP_URL=http://localhost:5173

# Optional web build defaults. Prefer entering the token in the setup screen.
VITE_API_URL=http://localhost:8787
VITE_API_TOKEN=
