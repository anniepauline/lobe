{
  "name": "@lobe/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "benchmark:vector": "bun run scripts/benchmark-vector-search.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "test:db": "RUN_DB_TESTS=1 bun test src/repositories.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lobe/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
